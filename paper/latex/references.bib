% Platt scaling. CORRECTED against the MIT Press record (doi:10.7551/mitpress/1113.003.0008,
% and the edited-book record doi:10.7551/mitpress/1113.001.0001): the chapter on pages 61-74
% is titled "Probabilities for SV Machines" and the book was published on 29 September 2000.
%
% It is widely cited under a different title and year -- "Probabilistic outputs for support
% vector machines and comparisons to regularized likelihood methods", 1999 -- including by
% Guo et al. 2017, Romano et al. 2020 and Angelopoulos et al. 2021, all of which also print
% a volume "10(3)" for a book that has none. Lin, Lin & Weng (Machine Learning, 2007) use the
% long title with year 2000 and the editors. The publisher's title and year are used here;
% "Platt scaling" in the text is the same method either way.
@incollection{platt2000probabilities,
  author    = {Platt, John C.},
  title     = {Probabilities for {SV} machines},
  editor    = {Smola, Alexander J. and Bartlett, Peter and Sch{\"o}lkopf, Bernhard and
               Schuurmans, Dale},
  booktitle = {Advances in Large-Margin Classifiers},
  publisher = {MIT Press},
  pages     = {61--74}, year = {2000},
  doi       = {10.7551/mitpress/1113.003.0008}
}

