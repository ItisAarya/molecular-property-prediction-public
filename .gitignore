# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
venv/
.venv/
env/

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Large / generated data artifacts ----
# Regenerated by scripts/prep_moleculenet.py, make_graphs.py, tokenize_smiles.py.
# Kept locally but never committed (too big, and reproducible from code).
data/*
!data/.gitkeep

# ---- Trained model weights & embeddings (regenerated by training) ----
models/*
!models/.gitkeep

# ---- Experiment outputs ----
# Metrics CSV/JSON are small and worth versioning; predictions & figures are not.
results/preds/*
!results/preds/.gitkeep
results/figs/*
!results/figs/.gitkeep
results/**/*.npy

# ---- Secrets / local config ----
*.env
.env
secrets.*

# ---- Local-only notes (never publish) ----
PROVENANCE_LOCAL.md
CV__*.pdf
*_LOCAL.md

# ---- Misc ----
*.log
wandb/

# Pooled features + generated split indices (rebuilt by scripts/build_pool.py + make_splits.py)
data/pool/
data/splits/

# Colab bundle (regenerate with scripts/make_colab_bundle.py)
mpp_colab_bundle.zip

# Colab bundles are build products of scripts/make_colab_bundle.py. The fusion one is
# tracked because it is small and the notebook names it; the Phase 3 regeneration bundle
# carries the cached ChemBERTa embeddings and is 126 MB, over GitHub's 100 MB file limit.
#   python -m scripts.make_colab_bundle --preset fusion-cached --out mpp_phase3_regen.zip
mpp_phase3_regen.zip

# The bilinear rank sweep's bundle, same preset and the same 100 MB problem (132 MB).
# Rebuild rather than fetch -- and rebuild it rather than reusing mpp_phase3_regen.zip,
# which was packed before loop.py started recording the device and seed.
#   python -m scripts.make_colab_bundle --preset fusion-cached --out mpp_rank_sweep.zip
mpp_rank_sweep.zip

# Editor/agent tooling, not project content. launch.json holds a machine-specific
# interpreter path, so it is useless to anyone else and misleading if committed.
.local-tooling/
